{
  "name": "lib-synology-dsm",
  // Python 3.13 — matches CI matrix upper bound (3.10–3.13).
  // Min supported: 3.10 (requires-python in pyproject.toml).
  // To test against min: change to mcr.microsoft.com/devcontainers/python:3.10
  "image": "mcr.microsoft.com/devcontainers/python:3.13",

  // pre-commit install is intentionally omitted: .git/hooks is owned by the Windows host user
  // and cannot be written from inside the container (UID mismatch on mounted volume).
  // Run `pre-commit install` once from Git Bash on the host — hooks apply to all git commits.
  "postCreateCommand": "sudo pip install -e '.[dev]'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "hbenl.vscode-test-explorer",
        "littlefoxteam.vscode-python-test-adapter",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true,

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },

        "ruff.enable": true,
        "ruff.lint.enable": true,

        "mypy-type-checker.args": ["--ignore-missing-imports"],

        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/unit"],
        "python.testing.unittestEnabled": false,

        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },

  "remoteEnv": {
    "NAS_HOST": "${localEnv:NAS_HOST}",
    "NAS_PORT": "${localEnv:NAS_PORT}",
    "API_USER": "${localEnv:API_USER}",
    "API_PASS": "${localEnv:API_PASS}",
    "NFS_CLIENT": "${localEnv:NFS_CLIENT}"
  }
}

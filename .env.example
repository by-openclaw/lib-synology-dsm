# lib-synology-dsm — integration test environment
# Copy to .env and fill in values before running: pytest tests/integration/ -v
# .env is gitignored — never commit real credentials.
#
# Load into shell before running tests:
#   export $(grep -v '^#' .env | xargs)
#   pytest tests/integration/ -v
#
# IMPORTANT: do not add inline comments (# ...) after values — they break xargs parsing.

# ── Integration tests (live NAS) ───────────────────────────────────────────
NAS_HOST=your-nas-ip
NAS_PORT=5001
API_USER=your-dsm-admin-user
API_PASS=your-dsm-password

# ── Optional overrides ─────────────────────────────────────────────────────
# NFS_CLIENT=10.6.225.0/24
# FS_BASE_SHARE=by-terraform-state
# TEST_USER_PASS=TmpPass123!

# ── EnvCredentialProvider (lib usage in scripts/Ansible, not for tests) ────
# SYNOLOGY_HOST=your-nas-ip
# SYNOLOGY_PORT=5001
# SYNOLOGY_USER=your-dsm-user
# SYNOLOGY_PASS=your-dsm-password

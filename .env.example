# lib-synology-dsm — integration test environment
# Copy to .env and fill in values before running integration tests.
# .env is gitignored — never commit real credentials.

# ── DSM connection ──────────────────────────────────────────────────────────
SYNOLOGY_HOST=your-nas-host          # IP or hostname (e.g. 192.168.1.100)
SYNOLOGY_PORT=5001                   # HTTPS port (default 5001)
SYNOLOGY_USER=your-dsm-user          # DSM admin user
SYNOLOGY_PASS=your-dsm-password

# ── Integration test accounts ──────────────────────────────────────────────
NAS_HOST=your-nas-host               # same as SYNOLOGY_HOST
API_USER=your-dsm-user               # admin account (needs administrators group)
API_PASS=your-dsm-password

AUDIT_USER=your-audit-user           # read-only DSM account for audit tests
AUDIT_PASS=your-audit-password

# ── NFS ────────────────────────────────────────────────────────────────────
NFS_CLIENT=192.168.x.x               # IP or CIDR to whitelist in NFS rules

# ── Optional: HashiCorp Vault (if using VaultCredentialProvider) ───────────
# VAULT_ADDR=https://vault.your-domain.arpa
# VAULT_TOKEN=your-vault-token

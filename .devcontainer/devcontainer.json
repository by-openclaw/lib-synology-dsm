{
  "name": "lib-synology-dsm",

  // Python 3.13 — matches CI matrix upper bound (3.10–3.13).
  // Min supported: 3.10 (requires-python in pyproject.toml).
  // To test against minimum: change to mcr.microsoft.com/devcontainers/python:3.10
  "image": "mcr.microsoft.com/devcontainers/python:3.13",

  // ── LAN access (Synology NAS on local network) ────────────────────────────
  // Docker Desktop for Windows routes LAN traffic (10.x.x.x) via 192.168.65.1
  // by default — no special network config needed. NAS is reachable as-is.

  // ── Credentials ───────────────────────────────────────────────────────────
  // Copy .devcontainer/.env.local.example → .devcontainer/.env.local and fill in credentials.
  // The file is gitignored and mounted read-only into the container via the workspace mount.
  // Integration tests load it automatically via python-dotenv (dotenv_path=.devcontainer/.env.local).
  // No --env-file in runArgs — container always starts even if .env.local doesn't exist yet.

  // remoteUser root: avoids pip permission issues on site-packages in container.
  // pre-commit install intentionally omitted: .git/hooks is owned by the Windows
  // host user and cannot be written from inside the container.
  // → Always commit from Git Bash on the host. Run pre-commit install once there.
  "remoteUser": "root",

  // sed -i strips Windows \r line endings from .env.local so python-dotenv loads cleanly.
  "postCreateCommand": "pip install -e '.[container]' && sed -i 's/\\r//' .devcontainer/.env.local 2>/dev/null || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "hbenl.vscode-test-explorer",
        "littlefoxteam.vscode-python-test-adapter",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true,

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },

        "ruff.enable": true,
        "ruff.lint.enable": true,

        "mypy-type-checker.args": ["--ignore-missing-imports"],

        // Unit tests run in VS Code test explorer (no NAS needed).
        // Integration tests require LAN access — run from container terminal:
        //   pytest tests/integration/ -m integration -v
        // curl scripts:
        //   bash tests/integration/curl/00-auth.sh
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/unit"],
        "python.testing.unittestEnabled": false,

        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  }

  // Credentials are loaded via --env-file .devcontainer/.env.local (see runArgs above).
  // No persistent Windows env vars needed. No remoteEnv block required.
}

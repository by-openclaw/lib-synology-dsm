{
  "name": "lib-synology-dsm",

  // Python 3.13 — matches CI matrix upper bound (3.10–3.13).
  // Min supported: 3.10 (requires-python in pyproject.toml).
  // To test against minimum: change to mcr.microsoft.com/devcontainers/python:3.10
  "image": "mcr.microsoft.com/devcontainers/python:3.13",

  // ── LAN access (Synology NAS on local network) ────────────────────────────
  // Docker Desktop routes LAN traffic (10.x.x.x) via host gateway — no extra config needed.

  // ── Credentials ───────────────────────────────────────────────────────────
  // Single file: cp .env.example .env — fill in API_PASS and TEST_USER_PASS.
  // Same .env works for native Python and inside the container.
  // conftest.py loads it automatically via python-dotenv — no --env-file needed.
  // Container starts cleanly even if .env doesn't exist yet.

  // remoteUser root: avoids pip permission issues on site-packages in container.
  // pre-commit install intentionally omitted: .git/hooks is owned by the host user
  // and cannot be written from inside the container.
  // → Always commit from Git Bash / terminal on the host. Run pre-commit install once there.
  "remoteUser": "root",

  // Strip Windows \r line endings from .env so python-dotenv parses cleanly.
  "postCreateCommand": "pip install -e '.[container]' && sed -i 's/\\r//' .env 2>/dev/null || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "hbenl.vscode-test-explorer",
        "littlefoxteam.vscode-python-test-adapter",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true,

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },

        "ruff.enable": true,
        "ruff.lint.enable": true,

        "mypy-type-checker.args": ["--ignore-missing-imports"],

        // Unit tests run in VS Code test explorer (no NAS needed).
        // Integration tests require LAN access — run from container terminal:
        //   pytest tests/integration/ -m integration -v
        // curl scripts:
        //   bash tests/integration/curl/00-auth.sh
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/unit"],
        "python.testing.unittestEnabled": false,

        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  }
}

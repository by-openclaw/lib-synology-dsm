# lib-synology-dsm — integration test environment
# Copy to .env and fill in values before running: pytest tests/integration/ -v
# .env is gitignored — never commit real credentials.

# ── Integration tests (live NAS) ───────────────────────────────────────────
NAS_HOST=your-nas-ip               # IP or hostname (e.g. 10.6.224.102)
NAS_PORT=5001                      # HTTPS port (default 5001)
API_USER=your-dsm-admin-user       # DSM user in administrators group
API_PASS=your-dsm-password

# ── Optional overrides ─────────────────────────────────────────────────────
# NFS_CLIENT=10.6.225.0/24        # IP/CIDR used in NFS rule tests (default: 10.6.224.0/20)
# FS_BASE_SHARE=by-terraform-state # Share used for FileStation tests (default: by-terraform-state)
# TEST_USER_PASS=TmpPass123!       # Temp password for test users created during run (default: TmpPass123!)

# ── EnvCredentialProvider (lib usage, not integration tests) ───────────────
# If you use DSMClient via get_credentials() in your own scripts:
# SYNOLOGY_HOST=your-nas-ip
# SYNOLOGY_PORT=5001
# SYNOLOGY_USER=your-dsm-user
# SYNOLOGY_PASS=your-dsm-password

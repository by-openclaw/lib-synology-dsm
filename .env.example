# lib-synology-dsm — integration test environment
# Copy to .env and fill in values before running tests.
# .env is gitignored — never commit real credentials.
#
# Works for both native Python and the dev container — same file, same path.
#
# Native:
#   cp .env.example .env
#   # edit .env — fill in API_PASS and TEST_USER_PASS
#   pytest tests/integration/ -v
#
# Dev container:
#   cp .env.example .env
#   # edit .env — fill in API_PASS and TEST_USER_PASS
#   # (re)open in container — conftest picks it up automatically

# ── Integration tests (live NAS) ───────────────────────────────────────────
NAS_HOST=10.6.224.6
NAS_PORT=5001
API_USER=rune-api
API_PASS=
NFS_CLIENT=10.6.224.0/20
FS_BASE_SHARE=by-terraform-state
TEST_USER_PASS=

# ── EnvCredentialProvider (lib usage in scripts/Ansible, not for tests) ────
# SYNOLOGY_HOST=10.6.224.6
# SYNOLOGY_PORT=5001
# SYNOLOGY_USER=rune-api
# SYNOLOGY_PASS=
